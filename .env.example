# Persistent SQLite Database File Path
# Mount a persistent volume here in production (e.g., /data/midday-buddy.sqlite)
DATABASE_PATH=".data/midday-buddy.sqlite"

# Initial Platform Administrator Bootstrap Credentials (PBKDF2 hashed on first boot)
ADMIN_EMAIL="admin@middaybuddy.com"
ADMIN_PASSWORD="CHANGE_ME_IN_PRODUCTION"

# HTTP Server Port (defaults to 3000)
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
