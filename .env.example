# ============================================================
# MidDay Buddy · PostgreSQL Configuration (Supabase / Self-Managed)
# ============================================================
# Standard PostgreSQL connection URI.
# - Supabase (Recommended: Transaction Pooler URI on port 6543):
#     DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# - Self-Managed PostgreSQL (Docker / VPS / RDS / Cloud SQL):
#     DATABASE_URL="postgresql://<user>:<password>@<host>:5432/midday_buddy"
DATABASE_URL=

# Optional SSL mode override:
# - Leave blank for automatic detection (SSL enabled for Supabase/remote hosts, disabled for localhost/docker).
# - Set "true" or "require" to force TLS, or "false" to disable TLS on private networks.
DATABASE_SSL=

# Optional PEM-encoded CA certificate for strict TLS verification (DATABASE_SSL_CA)
DATABASE_SSL_CA=

# Optional connection pool size (defaults to 10; ideal for Supabase pooler & Cloud Run)
PGPOOL_MAX=10

# Optional discrete PostgreSQL parameters (used only if DATABASE_URL is omitted)
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Optional Initial Platform Administrator Bootstrap Credentials
# If ADMIN_PASSWORD is omitted, the /admin portal opens a secure one-time first-admin setup form.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# HTTP Server Port (defaults to 3000)
PORT=3000

# Public Application URL
APP_URL=
