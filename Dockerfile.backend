# MidDay Buddy — Production Backend Container
# Stateless API server designed for multi-replica Cloud Run, Kubernetes, or Docker Swarm deployments.
# Connects to Supabase Managed PostgreSQL or Self-Managed PostgreSQL via DATABASE_URL.
FROM node:22-alpine AS base
WORKDIR /app

# Install production dependencies + TypeScript runtime
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev && npm install tsx

# Copy backend source & single-source-of-truth SQL migrations
COPY server.ts tsconfig.json ./
COPY src/server ./src/server
COPY src/types ./src/types
COPY src/utils ./src/utils
COPY src/data ./src/data
COPY scripts ./scripts
COPY supabase/migrations ./supabase/migrations

# Drop root privileges
RUN chown -R node:node /app
USER node

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1

CMD ["npx", "tsx", "server.ts"]
