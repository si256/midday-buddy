# MidDay Buddy — Production Backend Container
# Designed for multi-replica deployment behind Nginx / HAProxy / Docker Swarm
FROM node:22-alpine AS base
WORKDIR /app

# Install production + runtime tsx dependencies
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev && npm install tsx

# Copy backend source & schema
COPY server.ts tsconfig.json postgres-schema.sql ./
COPY src/server ./src/server
COPY src/types ./src/types
COPY src/utils ./src/utils
COPY src/data ./src/data

# Create writable data directory for fallback file persistence & drop root privileges
RUN mkdir -p /app/.data && chown -R node:node /app
USER node

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1

CMD ["npx", "tsx", "server.ts"]
